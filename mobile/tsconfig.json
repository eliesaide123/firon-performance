{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "paths": {
      "@firon/shared": [
        "../shared/src/index.ts"
      ],
      "@firon/shared/*": [
        "../shared/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../shared/src/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ]
}
