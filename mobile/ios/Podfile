# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported

# Xcode 27 only accepts iOS deployment targets in the range 15.0–27.0. Several third-party pods —
# and, more often, the *_Privacy resource bundles CocoaPods generates for them — still declare
# 9.0–13.0, which fails the build outright with:
#   "The iOS Simulator deployment target 'IPHONEOS_DEPLOYMENT_TARGET' is set to 9.0, but the
#    range of supported deployment target versions is 15.0 to 27.0.x."
# The post_install hook below raises every pod target to this floor. Keep it in step with the
# app target's own IPHONEOS_DEPLOYMENT_TARGET.
FIRON_IOS_MIN = '15.1'

# @react-native-firebase 26 resolves the Firebase iOS SDK through SPM by default,
# which collides with React Native 0.87's static library linkage. Opt out so the
# CocoaPods-distributed Firebase SDK is used instead.
$RNFirebaseDisableSPM = true
prepare_react_native_project!

# ---------------------------------------------------------------------------------------------
# Linkage decision for Firebase (docs/FIREBASE.md "Pods / linkage" explains this in full).
#
# The classic trap is reaching for a project-wide `use_frameworks!` to make Firebase's Swift pods
# importable. Don't: with RN 0.87 + Hermes, `use_frameworks!` turns every pod into a dynamic
# framework, which breaks the prebuilt React-Core / hermes-engine artifacts this project uses and
# forces `:linkage => :static` gymnastics for Flipper. We keep the DEFAULT static-library layout
# and instead grant `:modular_headers => true` to just the Google/Firebase C pods below, which is
# all that is needed for FirebaseCore's umbrella headers to be `@import`-able from the Swift parts
# of the Firebase SDK. `USE_FRAMEWORKS` is still honoured if you ever need to experiment, but the
# supported configuration for this repo is the one you get with it unset.
# ---------------------------------------------------------------------------------------------
linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'FironPerformance' do
  config = use_native_modules!

  # Firebase's Swift pods need module maps to be importable from a static library.
  # Scoped to the Google/Firebase C pods so the rest of the project keeps the
  # default (faster, non-modular) header layout.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Raise any pod target below FIRON_IOS_MIN. react_native_post_install does not touch the
    # generated resource-bundle targets, which are the ones that actually fail under Xcode 27.
    bumped = []
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |bc|
        current = bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.nil? || current.to_f < FIRON_IOS_MIN.to_f
          bumped << "#{target.name} (#{current || 'unset'})"
          bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = FIRON_IOS_MIN
        end
      end
    end

    # The Pods project's own configurations too, so newly generated targets inherit the floor.
    installer.pods_project.build_configurations.each do |bc|
      current = bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if current.nil? || current.to_f < FIRON_IOS_MIN.to_f
        bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = FIRON_IOS_MIN
      end
    end

    unless bumped.empty?
      Pod::UI.puts "Raised #{bumped.uniq.length} pod target(s) to iOS #{FIRON_IOS_MIN}".green
    end
  end
end
