# ---------------------------------------------------------------------------
# Firon Performance — backend environment
# Copy to `.env` and adjust. `.env` is gitignored; this file is committed.
# ---------------------------------------------------------------------------

PORT=4000
NODE_ENV=development

# Mongo
MONGO_URI=mongodb://127.0.0.1:27017/firon_performance

# JWT — CHANGE BOTH SECRETS BEFORE DEPLOYING
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Refresh lifetime when the client sends `remember: true` on login
JWT_REFRESH_TTL_REMEMBER=90d
# Lifetime of the short-lived token returned by verify-otp(purpose=reset)
JWT_RESET_TTL=15m

# CORS — comma separated. CMS dev server + any extra web origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Uploads (relative paths resolve against backend/)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=200
# Set when the API is behind a proxy/tunnel so /uploads URLs are absolute+correct.
# Leave empty to derive the origin from each request.
PUBLIC_URL=

# Firebase Cloud Messaging. If this file is absent, push silently no-ops
# (one warning at boot) and everything else keeps working.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# OTP
OTP_TTL_MINUTES=10
# Always accepted while NODE_ENV !== 'production' (matches the prototype demo)
OTP_DEV_CODE=1234
OTP_MAX_ATTEMPTS=5

# Logging: trace | debug | info | warn | error
LOG_LEVEL=debug

# How often `dashboard:tick` is pushed to role:admin (ms)
DASHBOARD_TICK_MS=30000
